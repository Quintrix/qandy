// qandy sends keydown event here
window.keydown = function(kc, ev) {
  try {
    var key = (ev && ev.key) ? ev.key : String.fromCharCode(kc || 0);
    if (ev && ev.shiftKey) print('shift ');
    if (ev && ev.ctrlKey)  print('ctrl ');
    if (ev && ev.altKey)   print('alt ');
    t=(ev && ev.timeStamp ? Math.round(ev.timeStamp) : Date.now());
    print(" "+kc+" "+key+" "+t+"\n");
  } catch (e) { print('Error: keydown() '+e+'\n'); }
  if (key == "Escape") { window.dosExit(); }
};

