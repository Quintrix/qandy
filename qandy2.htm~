function validateGuestFilename(name) {
  if (typeof name !== 'string' && typeof name !== 'number') return null;
  var s = String(name).trim();
  if (!s) return null;
  // Reject path separators and traversal
  if (/[\/\\]/.test(s)) return null;
  if (/\.\./.test(s)) return null;
  // Allow letters, numbers, spaces, dot, dash, underscore (adjust to taste)
  // Limit length to reasonable size to avoid DOS attacks
  if (s.length > 128) return null;
  if (!/^[A-Za-z0-9 _.\-]+$/.test(s)) return null;
  // Optionally normalize repeated spaces
  s = s.replace(/\s+/g, ' ');
  return s;
}

function dosXmitQdos(iframe, id, action, ok, resultOrError) {
  if (!iframe || !iframe.contentWindow) return;
  var msg = { type: 'action-result', action: action, id: id, success: Boolean(ok) };
  if (ok) {
    var r = resultOrError;
    if (Array.isArray(r)) r = r.join('\n');
    else if (r === null || typeof r === 'undefined') r = '';
    else if (typeof r === 'object') {
      try { r = JSON.stringify(r); } catch (e) { r = String(r); }
    } else r = String(r);
    msg.result = r;
  } else {
    msg.error = String(resultOrError || 'error');
  }
  try { iframe.contentWindow.postMessage(msg, '*'); } catch (e) {
    console.warn('dosXmitQdos: postMessage failed', e);
  }
}

