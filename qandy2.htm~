      .replace(/<\/script>/gi, '<\\/script>');        // escape closing script sequences
  }
}

function hostMessageHandler(ev) {
  //if (!iframe.contentWindow || ev.source !== iframe.contentWindow) {
  //  console.log("Message is not from our iframe");
  //  return;
  //}
  var iframe = window._vmIframe || document.getElementById('vm-iframe');
  if (!iframe || !iframe.contentWindow || ev.source !== iframe.contentWindow) { return; }
  var d = ev.data || {}; if (!d || typeof d !== 'object') return;
  
  if (d.type === 'guest-action' && typeof d.action === 'string') {
    try {
      switch(d.action) {
      
        case 'sysop': { sysop(); break; }
        case 'user': { sysop(); break; }
        
        case 'localList': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          // call localDir() and handle both sync and Promise-returning implementations
          Promise.resolve().then(function () { return localList(); })
            .then(function (result) {
              dosXmitQdos(_dosIframe, d.id, 'localList', true, result);
            })
            .catch(function (err) {
              dosXmitQdos(_dosIframe, d.id, 'localList', false, err && err.message ? err.message : String(err));
            });
          break;
        }

        case 'localDir': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          // call localDir() and handle both sync and Promise-returning implementations
          Promise.resolve().then(function () { return localDir(); })
            .then(function (result) {
              dosXmitQdos(_dosIframe, d.id, 'localList', true, result);
            })
            .catch(function (err) {
              dosXmitQdos(_dosIframe, d.id, 'localList', false, err && err.message ? err.message : String(err));
            });
          break;
        }

        case 'localLoad': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          // coerce and validate filename
          var fname = (typeof d.file === 'undefined' || d.file === null) ? '' : String(d.file);
          var validName = validateGuestFilename(fname);
          if (!validName) {
            // reject invalid filenames explicitly
            dosXmitQdos(_dosIframe, d.id, 'localLoad', false, 'invalid filename');
            break;
          }

          // call localLoad (supports sync or Promise)
          Promise.resolve().then(function () { return localLoad(validName); })
            .then(function (result) {
              // result could be string (file contents) or some other object; dosXmitQdos will normalize
              dosXmitQdos(_dosIframe, d.id, 'localLoad', true, result);
            })
            .catch(function (err) {
              dosXmitQdos(_dosIframe, d.id, 'localLoad', false, err && err.message ? err.message : String(err));
            });
          break;
        }
        
        case 'localSave': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          localSave(d.file, d.data).then(function(result) {
            if (_dosIframe && _dosIframe.contentWindow) {
              if (result === true) {
                _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'localSave', id: d.id, success: true, result: true }, '*');
              } else {
                _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'localSave', id: d.id, success: false, error: String(result) }, '*');
              }
            }
          }).catch(function(e) {
            if (_dosIframe && _dosIframe.contentWindow) {
              _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'localSave', id: d.id, success: false, error: String(e) }, '*');
            }
          });
          break;
        }

        case 'localDelete': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          var fname = (typeof d.file === 'undefined' || d.file === null) ? '' : String(d.file);
          var validName = (typeof validateGuestFilename === 'function') ? validateGuestFilename(fname) : null;
          if (!validName) {
            dosXmitQdos(_dosIframe, d.id, 'localDelete', false, 'invalid filename');
            break;
          }
          Promise.resolve().then(function () { return localDelete(validName); })
            .then(function (result) {
              dosXmitQdos(_dosIframe, d.id, 'localDelete', true, result === undefined ? true : result);
            })
            .catch(function (err) {
              dosXmitQdos(_dosIframe, d.id, 'localDelete', false, err && err.message ? err.message : String(err));
            });
          break;
        }
        
        case 'localExists': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          localExists(d.file).then(function(result) {
            if (_dosIframe && _dosIframe.contentWindow) {
              _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'localExists', id: d.id, success: true, result: result }, '*');
            }
          }).catch(function(e) {
            if (_dosIframe && _dosIframe.contentWindow) {
              _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'localExists', id: d.id, success: false, error: String(e) }, '*');
            }
          });
          break;
        }

        case 'localRename': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          var src = (typeof d.file === 'undefined' || d.file === null) ? '' : String(d.file);
          var dest = (typeof d.dest === 'undefined' || d.dest === null) ? '' : String(d.dest);
          var validSrc = (typeof validateGuestFilename === 'function') ? validateGuestFilename(src) : null;
          var validDest = (typeof validateGuestFilename === 'function') ? validateGuestFilename(dest) : null;
          if (!validSrc || !validDest) { dosXmitQdos(_dosIframe, d.id, 'localRename', false, 'invalid filename(s)'); break; }
          if (validSrc === validDest) { dosXmitQdos(_dosIframe, d.id, 'localRename', false, 'source and destination are identical'); break; }
          if (typeof localRename !== 'function') { dosXmitQdos(_dosIframe, d.id, 'localRename', false, 'host: rename not supported'); break; }
          Promise.resolve().then(function () { return localRename(validSrc, validDest); })
            .then(function (result) {
              dosXmitQdos(_dosIframe, d.id, 'localRename', true, result === undefined ? true : result);
            })
            .catch(function (err) {
              dosXmitQdos(_dosIframe, d.id, 'localRename', false, err && err.message ? err.message : String(err));
            });
          break;
        }

        case 'dosMount': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          try {
            // For the host-backed guest device, only 'local' is supported
            var _reqDev = (d.device == null || String(d.device).trim() === '') ? null : String(d.device).trim();
            var _curDev = (typeof DEVICE !== 'undefined') ? DEVICE : 'local';
            var _result = _reqDev || _curDev;
            if (_dosIframe && _dosIframe.contentWindow) {
              _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'dos-mount', id: d.id, success: true, result: _result }, '*');
            }
          } catch (_e) {
            if (_dosIframe && _dosIframe.contentWindow) {
              _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'dos-mount', id: d.id, success: false, error: String(_e) }, '*');
            }
          }
          break;
        }

        case 'qdosPaste': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          var fname = (typeof d.file === 'undefined' || d.file === null) ? '' : String(d.file).trim();
          var validName = (typeof validateGuestFilename === 'function') ? validateGuestFilename(fname) : null;
          if (!validName) { dosXmitQdos(_dosIframe, d.id, 'qdosPaste', false, 'invalid filename'); break; }
