          Promise.resolve().then(function () { return dosPaste(validName); })
            .then(function (result) {
              dosXmitQdos(_dosIframe, d.id, 'qdosPaste', true, result === undefined ? true : result);
            })
            .catch(function (err) {
              dosXmitQdos(_dosIframe, d.id, 'qdosPaste', false, err && err.message ? err.message : String(err));
            });
          break;
        }
        
        case 'dosExists': {
          var _dosIframe = window._vmIframe || document.getElementById('vm-iframe');
          var fname = (typeof d.file === 'undefined' || d.file === null) ? '' : String(d.file).trim();
          // Normalize validateGuestFilename return values to a filename string or null
          var validName = null;
          var v = validateGuestFilename(fname);
          if (typeof v === 'string') validName = v.trim();
          else if (v === true) validName = fname; // true => original name is valid
