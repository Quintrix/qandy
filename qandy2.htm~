                for (var _ci = 0; _ci < _clrList.length; _ci++) localStorage.removeItem(_LS_PFX + _clrList[_ci]);
              }
              // write new files
              var _newList = [];
              var _impKeys = Object.keys(_impObj.files);
              for (var _ii = 0; _ii < _impKeys.length; _ii++) {
                var _iname = _impKeys[_ii];
                var _ival = _impObj.files[_iname];
                localStorage.setItem(_LS_PFX + _iname, _ival == null ? '' : String(_ival));
                _newList.push(_iname);
              }
              localStorage.setItem(_LS_MAN, JSON.stringify(_newList));
              if (_dosIframe && _dosIframe.contentWindow) {
                _dosIframe.contentWindow.postMessage({ type: 'action-result', action: 'dos-format', id: d.id, success: true, result: true }, '*');
