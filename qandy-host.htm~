    //var txt = await getScriptText(name, 4000).catch(()=> '');
    if (!txt) {
      scriptMap[name] = null; // mark missing; guest can request later via postMessage
    } else {
      var s = sanitizeScriptText(txt);
      s += '\n//# sourceURL=' + name;
      scriptMap[name] = s;
    }
  }

  // Build HTML parts
  var parts = [];
  parts.push('<!doctype html>');
  parts.push('<html>');
  parts.push('<head>');
    
  //var CSS_NAME = options && options.cssName ? options.cssName : 'qandy.css';
  //var cssText = (options && typeof options.cssText === 'string' && options.cssText.length)
  //  ? options.cssText
  //  : ((window._embeddedFiles && window._embeddedFiles[CSS_NAME]) || '');
  //if (!cssText) {
  //  try {
  //    // fetch may fail on file:// — that's why we prefer options/_embeddedFiles first
  //    var respCss = await fetch(CSS_NAME, { cache: 'no-cache' }).catch(function(){ return null; });
  //    if (respCss && respCss.ok) cssText = await respCss.text();
  //  } catch (e) {
  //    cssText = cssText || '';
  //  }
  //}
    
  parts.push('<meta charset="utf-8">');
  parts.push('<meta name="viewport" content="width=device-width,initial-scale=1">');

  var cssText = document.querySelector('style').innerHTML;
  if (cssText) parts.push('<style>\n' + cssText + '\n</style>');

  parts.push('<script>window._QANDY_ASSEMBLED = true; window.QANDY = window.QANDY || {}; window.QANDY.mode = "guest";</' + 'script>');
  // Embed the HOST_SCRIPTS map (JSON-stringified; escape closing tags)
  var jsonMap = JSON.stringify(scriptMap).replace(/<\/script>/gi, '<\\/script>');
  parts.push('<script>window.HOST_SCRIPTS = ' + jsonMap + ';</' + 'script>');
  // Guest helper: runHostScript(name) and requestFromHost(name)
  parts.push('<script>\n' +
  '/* Guest-side helpers injected by host */\n' +
  'window.runHostScript = function(name) {\n' +
      '  try {\n' +
      '    var code = (window.HOST_SCRIPTS && window.HOST_SCRIPTS[name]) || null;\n' +
      '    if (!code) {\n' +
      '      // signal host to fetch it if not present\n' +
      '      if (window.parent && window.parent !== window) {\n' +
      '        var id = Math.random().toString(36).slice(2);\n' +
      '        window._pendingScriptRequests = window._pendingScriptRequests || {};\n' +
      '        window._pendingScriptRequests[id] = name;\n' +
      '        window.parent.postMessage({ type: \"request-script\", id: id, name: name }, \"*\");\n' +
      '      }\n' +
      '      return false;\n' +
      '    }\n' +
      '    // Prefer executeCode() if available (executes in the intended VM context)\n' +
      '    if (typeof executeCode === \"function\") {\n' +
      '      executeCode(String(code));\n' +
      '    } else {\n' +
      '      // fallback: append a script tag (may be blocked by CSP)\n' +
      '      var s = document.createElement(\"script\");\n' +
      '      s.type = \"text/javascript\";\n' +
      '      s.textContent = code;\n' +
      '      document.head.appendChild(s);\n' +
      '    }\n' +
      '    return true;\n' +
      '  } catch (e) { console && console.error && console.error(\"runHostScript failed\", e); return false; }\n' +
      '};\n' +
      '\n' +
      '// Listen for host replies containing script text\n' +
      'window.addEventListener(\"message\", function(ev) {\n' +
      '  try {\n' +
      '    var d = ev.data || {};\n' +
      '    if (d && d.type === \"host-script\" && typeof d.name === \"string\") {\n' +
      '      // store it and optionally run if requested\n' +
      '      window.HOST_SCRIPTS = window.HOST_SCRIPTS || {};\n' +
      '      window.HOST_SCRIPTS[d.name] = d.code === null ? null : String(d.code || \"\") + \"\\n//# sourceURL=\" + d.name;\n' +
      '      // if we had previously requested this via id, auto-run\n' +
      '      if (d.id && window._pendingScriptRequests && window._pendingScriptRequests[d.id]) {\n' +
      '        try { window.runHostScript(d.name); } catch(e) {}\n' +
      '        delete window._pendingScriptRequests[d.id];\n' +
      '      }\n' +
      '    }\n' +
      '  } catch (e) { }\n' +
      '}, false);\n' +
      '\n' +
      '// starter: optional auto-execution order (run core scripts as needed)\n' +
      '(function(){ try { /* guest can decide order: e.g. runHostScript(\"memory.js\"); runHostScript(\"video.js\"); runHostScript(\"qandy.js\"); */ } catch(e){} })();\n' +
      '</' + 'script>');

    parts.push('</head>');
    
    // strip invisible characters that sometimes break parsing
    // bodyHtml = String(bodyHtml || '').replace(/[\u200B\uFEFF\u200C\u200D]/g, '');
    
    var bodyHtml = document.body.innerHTML;
    parts.push(bodyHtml);

    parts.push('<body>');    
    parts.push('</body>');
    parts.push('</html>');
    return parts.join('\n');
  }
  
  function sanitizeScriptText(txt) {
    return String(txt || '')
      .replace(/[\u200B\uFEFF\u200C\u200D]/g, '')      // strip invisible chars
      .replace(/<\/script>/gi, '<\\/script>');        // escape closing script sequences
  }

  async function createAndLoadVM(options) {
   if (ROOT==false) {
    options = options || {};
    var html = await assembleGuestHtml(options).catch(function (e) { console.error('assembleGuestHtml failed', e); return ''; });
    if (!html) throw new Error('assembleGuestHtml returned empty HTML');

    var vmContainer = document.createElement('div');
    vmContainer.id = 'vm-container';
    vmContainer.style.position = 'absolute';
    vmContainer.style.right = (typeof options.right === 'number' ? options.right : 10) + 'px';
    vmContainer.style.top = (typeof options.top === 'number' ? options.top : 10) + 'px';
    vmContainer.style.width = (options.width || 300) + 'px';
    vmContainer.style.height = (options.height || 600) + 'px';
    vmContainer.style.zIndex = String(options.zIndex || 100);
    vmContainer.style.background = options.containerBackground || '#111';
    vmContainer.style.border = '1px solid #333';
    vmContainer.style.borderRadius = '4px';
    vmContainer.style.overflow = 'hidden';

    var iframe = document.createElement('iframe');
    iframe.id = options.iframeId || 'vm-iframe';
    iframe.setAttribute('sandbox', 'allow-scripts'); // add allow-same-origin if required
    iframe.setAttribute('title', 'Qandy Virtual Machine');
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    iframe.style.border = '0';
    iframe.style.display = 'block';
    iframe.style.background = '#000';

    vmContainer.appendChild(iframe);
    document.body.appendChild(vmContainer);

    var blob = new Blob([html], { type: 'text/html' });
    var blobUrl = URL.createObjectURL(blob);
    iframe.src = blobUrl;

    iframe._qandyGuestBlobUrl = blobUrl;
    window._vmIframe = iframe;
    window._vmContainer = vmContainer;

    // Host listener: respond to guest requests for missing scripts
    function hostMessageHandler(ev) {
      // ensure message is from our iframe
      if (!iframe.contentWindow || ev.source !== iframe.contentWindow) return;
      var d = ev.data || {}; if (!d || typeof d !== 'object') return;
      if (d.type === 'request-script' && typeof d.name === 'string') {
        var reqId = d.id; var name = d.name;
        (async function() {
          try {
            var code = await getScriptText(name, 5000);
            if (!code) {
              iframe.contentWindow.postMessage({ type: 'host-script', id: reqId, name: name, code: null }, '*');
            } else {
              var s = sanitizeScriptText(code) + '\n//# sourceURL=' + name;
              iframe.contentWindow.postMessage({ type: 'host-script', id: reqId, name: name, code: s }, '*');
            }
          } catch (e) {
            iframe.contentWindow.postMessage({ type: 'host-script', id: reqId, name: name, code: null, error: String(e) }, '*');
          }
        })();
      }
    } 
    window.addEventListener('message', hostMessageHandler, false);

    iframe._qandyGuestCleanup = function () {
      try { URL.revokeObjectURL(blobUrl); } catch (e) {}
      window.removeEventListener('message', hostMessageHandler, false);
      if (iframe && iframe.parentNode) iframe.parentNode.removeChild(iframe);
      if (vmContainer && vmContainer.parentNode) vmContainer.parentNode.removeChild(vmContainer);
      window._vmIframe = null;
      window._vmContainer = null;
    };

    return { iframe: iframe, container: vmContainer, blobUrl: blobUrl };
   }
  }
 }
 
 
