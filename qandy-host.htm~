async function startup() {
  // Determine guest status (support sync or async isGuest)
  print("\n[cyan]Qandy Pocket\nComputer\n");
  if (!GUEST) {
    // host machine
    if (ROOT === 1) {
      // running in root mode (local access)
    } else {
      // create guest <iframe>
      console.info('assembling/creating guest VM (if available)');
      if (typeof createAndLoadVM === 'function') {
        try {
          await createAndLoadVM({
            bootScripts: ['sound.js','video.js','keyboard.js','command.js','qandy.js'],
            cssName: 'qandy.css',
            width: 300,
            height: 600,
            right: 10,
            top: 10,
            zIndex: 100,
            hideHost: false
          });
          console.info('startup: createAndLoadVM completed');
        } catch (e) {
          console.error('startup: createAndLoadVM failed', e);
        }
      } else if (typeof assembleGuestHtml === 'function') {
        try {
          var html = await assembleGuestHtml({ cssName: 'qandy.css' });
          var blob = new Blob([html], { type: 'text/html' });
          var url = URL.createObjectURL(blob);
          var iframe = document.createElement('iframe');
          iframe.setAttribute('sandbox', 'allow-scripts');
          iframe.style.width = '300px';
          iframe.style.height = '600px';
          iframe.src = url;
          document.body.appendChild(iframe);
          iframe._qandyGuestBlobUrl = url;
          window._vmIframe = iframe;
          console.info('startup: assembled guest blob loaded into iframe');
        } catch (e) {
          console.error('startup: assembleGuestHtml fallback failed', e);
        }
      } else {
        console.warn('startup: no createAndLoadVM or assembleGuestHtml available');
      }
    }

    // Listen once for guest-ready to optionally hide host UI / focus guest
    function onHostMessage(ev) {
      var d = ev && ev.data;
      if (d && typeof d === 'object' && d.type === 'guest-ready') {
        console.info('startup: guest reported ready (host may hide UI now)');
        try { if (window._vmIframe && window._vmIframe.contentWindow) window._vmIframe.contentWindow.focus(); } catch (e) {}
        window.removeEventListener('message', onHostMessage, false);
      }
    }
    window.addEventListener('message', onHostMessage, false);

  } else {
    console.info('startup: guest mode detected — skipping host assembly');
  }
}

function isGuest() {
  try {
    if (window.QANDY && typeof window.QANDY.mode === 'string') { return window.QANDY.mode === 'guest'; }
    if (typeof window._QANDY_ASSEMBLED !== 'undefined') { return !!window._QANDY_ASSEMBLED; }
    return (window.top && window.top !== window);
  } catch (e) {
    return true;
  }
}

Object.defineProperty(window, 'GUEST', {
  value: isGuest(),
  writable: true,
  configurable: true,
  enumerable: false
});

