      var file = evt.filename || '';
      var pos = ((typeof evt.lineno === 'number') ? (':' + evt.lineno + (evt.colno ? ':' + evt.colno : '')) : '');
      var header = '[UNCAUGHT ERROR] ' + message + (file ? (' @ ' + file + pos) : '');
