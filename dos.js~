    }
  }

  function _calcLocalStorage() {
    try {
      var total = 0;
      for (var i = 0; i < localStorage.length; i++) {
        var k = localStorage.key(i);
        if (!k) continue;
        var v = localStorage.getItem(k) || '';
        total += (k.length + v.length) * 2;
      }
      return total;
    } catch (e) {
      return null;
    }
  }

