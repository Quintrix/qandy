<script>


// Host preload module: read allowed files into memory before starting the host file server.
// Place this in qandy8.htm before you create the VM or install the host postMessage responder.

(function () {
  'use strict';

  // Configure what the host should preload
  var ALLOWED_FILES = [
    'qandy.css',
    'memory.js',
    'video.js',
    'gfx.js',
    'keyboard.js',
    'command.js',
    'dos.js',
    'qandy.js'
  ];

  // Internal caches exposed on window for file responder to use:
  window._embeddedFiles = window._embeddedFiles || {};   // text files: js/css/txt
  window._embeddedAssets = window._embeddedAssets || {}; // binary assets as data: URLs

  // Expose helper to manually embed a file at runtime (useful for file-picker)
  window.hostEmbedFile = function (name, content, isAsset) {
    if (!name) return;
    if (isAsset) {
      window._embeddedAssets[name] = String(content || '');
    } else {
      window._embeddedFiles[name] = String(content || '');
    }
  };

  // Helper to convert ArrayBuffer -> data: URL (base64)
  function arrayBufferToDataURL(ab, mime) {
    var u8 = new Uint8Array(ab);
    var CHUNK = 0x8000; // chunk for large buffers
    var s = [];
    for (var i = 0; i < u8.length; i += CHUNK) {
      s.push(String.fromCharCode.apply(null, u8.subarray(i, i + CHUNK)));
    }
    var binary = s.join('');
    var base64 = btoa(binary);
    return 'data:' + (mime || 'application/octet-stream') + ';base64,' + base64;
  }

  // Try load with fetch; for images we store data: URL
  async function loadWithFetch(name) {
    var resp = await fetch(name, { cache: 'no-cache' });
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    var ct = resp.headers.get('content-type') || '';
    if (ct.indexOf('text/') === 0 || ct.indexOf('application/javascript') === 0 || ct.indexOf('application/json') === 0 || name.match(/\.(js|css|txt|json)$/i)) {
      return { type: 'text', content: await resp.text() };
    } else {
      // binary -> dataURL
      var ab = await resp.arrayBuffer();
      var dataUrl = arrayBufferToDataURL(ab, ct.split(';')[0] || undefined);
      return { type: 'asset', content: dataUrl };
    }
  }

  // Try synchronous XHR (file:// fallback). Returns same shape as loadWithFetch.
  function loadWithSyncXHR(name) {
    var xhr = new XMLHttpRequest();
    try {
      xhr.open('GET', name, false); // synchronous
      // For local files, binary responses are tricky; request as 'ArrayBuffer' isn't supported synchronously,
      // so we use responseText and treat images specially via FileReader fallback (if user supplies).
      xhr.send(null);
    } catch (e) {
      throw new Error('XHR failed: ' + e.message);
    }
    var status = xhr.status;
    if (!(status === 0 || (status >= 200 && status < 300))) {
      throw new Error('XHR status ' + status);
    }
    // Heuristic for binary vs text: try to detect common text file extensions
    if (name.match(/\.(js|css|txt|json|html)$/i)) {
      return { type: 'text', content: xhr.responseText };
    } else {
      // For images, synchronous XHR responseText contains binary which is hard to reliably base64-encode;
      // we'll signal failure to allow user to use file-picker. Throw to fallback.
      throw new Error('binary sync XHR not supported for ' + name);
    }
  }

  // Attempt to load a single file using best available technique.
  async function preloadOne(name) {
    // skip if already embedded
    if (Object.prototype.hasOwnProperty.call(window._embeddedFiles, name) || Object.prototype.hasOwnProperty.call(window._embeddedAssets, name)) {
      return { name: name, status: 'cached' };
    }

    // Attempt fetch first (works under http(s))
    try {
      var r = await loadWithFetch(name);
      if (r.type === 'text') {
        window._embeddedFiles[name] = r.content;
      } else {
        window._embeddedAssets[name] = r.content;
      }
      return { name: name, status: 'ok', method: 'fetch' };
    } catch (fetchErr) {
      // If running from file://, fetch often fails due to CORS. Try synchronous XHR for text files.
      if (location.protocol === 'file:') {
        try {
          var xr = loadWithSyncXHR(name);
          if (xr.type === 'text') {
            window._embeddedFiles[name] = xr.content;
            return { name: name, status: 'ok', method: 'sync-xhr' };
          } else {
            // not handled
            return { name: name, status: 'failed', error: 'sync-xhr-binary' };
          }
        } catch (xhrErr) {
          return { name: name, status: 'failed', error: String(xhrErr) };
        }
      }
      return { name: name, status: 'failed', error: String(fetchErr) };
    }
  }

  // Preload all allowed files. Returns Promise that resolves to array of results.
  async function preloadFiles(options) {
    options = options || {};
    var list = options.files || ALLOWED_FILES;
    var results = [];
    for (var i = 0; i < list.length; i++) {
      try {
        var res = await preloadOne(list[i]);
        results.push(res);
      } catch (e) {
        results.push({ name: list[i], status: 'failed', error: String(e) });
      }
    }
    return results;
  }

  // If preload fails for some files, allow the user to pick files through a file input to embed them manually.
  function promptUserToEmbedMissing(results) {
    var missing = results.filter(r => r.status !== 'ok' && r.status !== 'cached').map(r => r.name);
    if (!missing.length) return Promise.resolve(results);
    return new Promise(function (resolve) {
      // create input if needed
      var input = document.createElement('input');
      input.type = 'file';
      input.multiple = true;
      input.style.display = 'none';
      // accept any file; user will choose the missing ones
      document.body.appendChild(input);
      input.addEventListener('change', function () {
        var files = Array.from(input.files || []);
        // try to match filenames to missing list
        var readPromises = files.map(function (f) {
          return new Promise(function (res) {
            var reader = new FileReader();
            reader.onload = function () {
              var name = f.name;
              var ext = name.split('.').pop().toLowerCase();
              if (['png','jpg','jpeg','gif','webp','svg'].indexOf(ext) !== -1) {
                // FileReader result is a dataURL if readAsDataURL used; we'll use that
                window._embeddedAssets[name] = reader.result;
              } else {
                window._embeddedFiles[name] = reader.result;
              }
              res({ name: name, status: 'embedded-by-user' });
            };
            // choose read mode
            var ext2 = f.name.split('.').pop().toLowerCase();
            if (['png','jpg','jpeg','gif','webp','svg'].indexOf(ext2) !== -1) {
              reader.readAsDataURL(f);
            } else {
              reader.readAsText(f, 'utf-8');
            }
          });
        });
        Promise.all(readPromises).then(function (rp) {
          // remove input
          try { input.parentNode.removeChild(input); } catch (e) {}
          resolve(results.concat(rp));
        });
      }, { once: true });
      // prompt user
      input.click();
    });
  }

  // Public: preload and return results. If some files failed to preload and options.promptOnFail === true,
  // prompt the user to pick files.
  window.hostPreloadFiles = async function (options) {
    options = options || {};
    var results = await preloadFiles(options);
    var failed = results.filter(r => r.status !== 'ok' && r.status !== 'cached');
    if (failed.length && options.promptOnFail) {
      var final = await promptUserToEmbedMissing(results);
      return final;
    }
    return results;
  };

  // Quick diagnostic log
  console.info('Host preload helper installed. Call hostPreloadFiles({ files: [...], promptOnFail: true }) to preload.');

})();



</script>
<script>
// create-virtual-iframe.js
// Drop this into qandy8.htm (inside a <script> tag) or include as an external script.
// It creates a sandboxed "virtual" iframe (the VM) with sandbox.htm as src,
// places it in a confined container (so it won't cover the #txt display),
// exposes the iframe as window._vmIframe and provides startVM()/stopVM() helpers.

(function createVirtualMachineModule() {
  'use strict';

  // Call createVirtualMachine() on DOMContentLoaded (you can call it earlier/later if you prefer)
  document.addEventListener('DOMContentLoaded', function () {
    // default creation: container appended to document.body
    createVirtualMachine({
      containerSelector: null, // null -> document.body, or '#guest-container'
      iframeId: 'vm-iframe',
      iframeSrc: 'sandbox.htm', // the VM page
      width: 300,
      height: 600,
      right: 10,
      top: 10,
      iframeZIndex: 100,      // keep lower than qandy overlay/text which uses very high z-index
      containerStyles: {
        background: '#111',
        border: '1px solid #333',
        borderRadius: '4px',
        overflow: 'hidden'
      }
    });
  }, { once: true });

  /**
   * Creates the VM iframe and returns an object with controls.
   * options:
   *   - containerSelector: css selector to append the container, or null -> document.body
   *   - iframeId: id for the iframe element
   *   - iframeSrc: src to load in iframe (sandbox.htm)
   *   - width, height, right, top: numeric px values for positioning
   *   - iframeZIndex: numeric z-index of iframe container
   *   - containerStyles: extra CSS styles applied to container
   */
  function createVirtualMachine(options) {
    options = options || {};
    var containerRoot = options.containerSelector ? document.querySelector(options.containerSelector) : document.body;
    if (!containerRoot) containerRoot = document.body;

    var iframeId = options.iframeId || 'vm-iframe';
    var src = options.iframeSrc || 'sandbox.htm';
    var width = (typeof options.width === 'number') ? options.width : 640;
    var height = (typeof options.height === 'number') ? options.height : 480;
    var right = (typeof options.right === 'number') ? options.right : 10;
    var top = (typeof options.top === 'number') ? options.top : 10;
    var z = (typeof options.iframeZIndex === 'number') ? options.iframeZIndex : 100;

    // Create container to hold the iframe and keep it out of the way of the main display
    var vmContainer = document.createElement('div');
    vmContainer.id = 'vm-container';
    vmContainer.style.position = 'absolute';
    vmContainer.style.right = right + 'px';
    vmContainer.style.top = top + 'px';
    vmContainer.style.width = width + 'px';
    vmContainer.style.height = height + 'px';
    vmContainer.style.zIndex = String(z);
    vmContainer.style.boxSizing = 'border-box';
    vmContainer.style.display = 'block';
    vmContainer.style.pointerEvents = 'auto';
    // apply optional user styles
    var userStyles = options.containerStyles || {};
    Object.keys(userStyles).forEach(function (k) { vmContainer.style[k] = userStyles[k]; });

    // Create the iframe
    var iframe = document.createElement('iframe');
    iframe.id = iframeId;
    iframe.src = src;
    // Sandbox with scripts allowed but no same-origin (prevents direct access to host localStorage/DOM)
    iframe.setAttribute('sandbox', 'allow-scripts');
    iframe.setAttribute('title', 'Qandy Virtual Machine');
    // Styling: fill the container
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    iframe.style.border = '0';
    iframe.style.display = 'block';
    iframe.style.background = '#000';

    // Append iframe to container, then container to DOM
    vmContainer.appendChild(iframe);
    containerRoot.appendChild(vmContainer);

    // Expose globally for deba qandy8.htm page that will create the ugging
    window._vmContainer = vmContainer;
    window._vmIframe = iframe;

    // When iframe loads, send a friendly "host-ready" message and log
    iframe.addEventListener('load', function () {
    try {
        iframe.contentWindow.postMessage({ type: 'host-ready' }, '*');
      } catch (e) { /* ignore cross-origin errors; sandboxed iframe allows postMessage */ }
      console.info('VM iframe loaded:', src);
    });

    // Optional: a simple message handler that only processes messages from this iframe
    window.addEventListener('message', function (ev) {
      if (!iframe || ev.source !== iframe.contentWindow) return; // ignore other frames
      // example: log vm messages
      try {
        var d = ev.data;
        // handle known message types here (file requests, vm-ready, logs, etc.)
        if (d && typeof d === 'object') {
          if (d.type === 'vm-ready') {
            console.info('VM reports ready');
          } else if (d.type === 'vm-log') {
            console.log('VM:', d.message);
          } else {
            // generic debug
            console.debug('Message from VM:', d);
          }
        }
      } catch (e) {}
    });

    // Helper to start VM: sends start-vm to the iframe. Call after host is ready (e.g. overlay removed)
    function startVM() {
      if (!iframe || !iframe.contentWindow) return Promise.reject(new Error('VM not available'));
      try {
        iframe.contentWindow.postMessage({ type: 'start-vm' }, '*');
        return Promise.resolve();
      } catch (e) {
        return Promise.reject(e);
      }
    }

    function stopVM() {
      try {
        iframe.contentWindow.postMessage({ type: 'stop-vm' }, '*');
      } catch (e) {}
    }

    function destroyVM() {
      try { if (vmContainer.parentNode) vmContainer.parentNode.removeChild(vmContainer); } catch (e) {}
      window._vmIframe = null;
      window._vmContainer = null;
    }

    return {
      container: vmContainer,
      iframe: iframe,
      start: startVM,
      stop: stopVM,
      destroy: destroyVM
    };
  }

  // Export as global for manual use
  window.createVirtualMachine = createVirtualMachine;

})();
</script>


