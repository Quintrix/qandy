<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>The Qandy Pocket Computer</title>
<style>
  html,body{height:100%;margin:0;padding:0;background:#333;color:#fff;font-family:system-ui,Segoe UI,Roboto,monospace;}
  .split-row{display:flex;flex-direction:row;align-items:flex-start;gap:64px;padding:32px;box-sizing:border-box;justify-content:center;}
  .display{background:#000;border-radius:6px;overflow:hidden;box-sizing:border-box;}
  .left .display{ width:364px; height:664px; }
  .right .display{ width:664px; height:480px; transform: translateX(-64px) translateY(48px); }
  .display iframe{ width:100%; height:100%; border:0; display:block; background:#000; }
  @media (max-width:1100px){ .split-row{ flex-direction:column; gap:16px; padding:16px; } .left .display, .right .display { width:100%; height:auto; aspect-ratio: 16/9; } }
</style>
</head>
<body>

<div class="split-row">
  <div class="bezel left">
    <div class="display">
      <!-- Make iframe focusable with tabindex and give it an id -->
      <iframe
        id="leftFrame"
        src="qandy7.htm"
        title="Qandy Pocket Computer — left"
        tabindex="0"
        loading="eager"
        ></iframe>
    </div>
  </div>

  <div class="bezel right">
    <div class="display">
      <iframe
        id="rightFrame"
        src="instructions.htm"
        title="Instructions — right"
        loading="eager"
        ></iframe>
    </div>
  </div>
</div>

<script>
(function(){
  const leftFrame = document.getElementById('leftFrame');

  // Try to focus the iframe when it finishes loading
  leftFrame.addEventListener('load', () => {
    // Prefer focusing the iframe element (works cross-origin)
    try { leftFrame.focus(); } catch(e) {}
    // Also try focusing the content window (works when same-origin)
    try { leftFrame.contentWindow && leftFrame.contentWindow.focus(); } catch(e) {}
  });

  // Ensure first user keypress focuses the iframe (useful if browser prevents auto-focus)
  function ensureFocus() {
    try { leftFrame.focus(); } catch(e) {}
    try { leftFrame.contentWindow && leftFrame.contentWindow.focus(); } catch(e) {}
    // remove listeners after first use
    window.removeEventListener('keydown', ensureFocus);
    window.removeEventListener('mousedown', ensureFocus);
    window.removeEventListener('touchstart', ensureFocus);
  }
  window.addEventListener('keydown', ensureFocus, {once:true});
  window.addEventListener('mousedown', ensureFocus, {once:true});
  window.addEventListener('touchstart', ensureFocus, {once:true});

  // Optional: provide an explicit way to focus by clicking the left display
  leftFrame.addEventListener('click', () => {
    try { leftFrame.focus(); } catch(e) {}
    try { leftFrame.contentWindow && leftFrame.contentWindow.focus(); } catch(e) {}
  });

  // Fallback: if focusing doesn't work in your environment, you can capture keys in the parent
  // and forward them via postMessage to the iframe. That requires a listener inside qandy7.htm.
  // Example (uncomment to enable):
  /*
  window.addEventListener('keydown', (ev) => {
    leftFrame.contentWindow.postMessage({ type: 'key', key: ev.key, code: ev.code, keyCode: ev.keyCode }, '*');
  });
  */
})();
</script>

</body>
</html>