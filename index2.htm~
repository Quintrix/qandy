<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Qandy Launcher</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 1rem; }
    button { font-size: 1rem; padding: 0.5rem 1rem; }
  </style>
</head>
<body>
  <h1>Qandy Launcher</h1>
  <p>
    Open a new Qandy window (multiple allowed):
  </p>

  <button id="open-qandy">Open Qandy</button>

  <script>
    (function(){
      // Desired content size of the emulated Qandy area (adjust to match qandy.htm)
      var CONTENT_WIDTH = 352;   // change to actual Qandy inner width
      var CONTENT_HEIGHT = 648;  // change to actual Qandy inner height

      // Rough extra pixel allowance for OS/title bar/chrome — tweak if you want exact fit
      var CHROME_W = 16;  // approximate vertical chrome (window edges)
      var CHROME_H = 40;  // approximate height for title bar + top/bottom borders

      function openQandy() {
        // Make a unique name so each click opens a new window rather than reusing one
        var winName = 'qandy_' + Date.now();

        // Compose features: hide menubar, toolbar, location/address, status, scrollbars
        var width = CONTENT_WIDTH + CHROME_W;
        var height = CONTENT_HEIGHT + CHROME_H;
        var features = [
          'width=' + width,
          'height=' + height,
          'menubar=yes',
          'toolbar=yes',
          'location=yes',
          'status=no',
          'scrollbars=no',
          'resizable=yes'    // prevent resize so Qandy fits exactly; set to yes if you want resizable windows
        ].join(',');

        var win = window.open('qandy.htm', winName, features);

        if (!win) {
          alert('Popup blocked — please allow popups for this site to open Qandy windows.');
          return;
        }

        // Attempt to remove default margins / overflow inside the opened page (same-origin required)
        // This helps avoid scrollbars if qandy.htm doesn't already set its own styles.
        try {
          win.onload = function() {
            try {
              var d = win.document;
              d.documentElement.style.overflow = 'hidden';
              d.body.style.margin = '0';
              d.body.style.overflow = 'hidden';
            } catch (e) {
              // cross-origin or other restriction — can't set styles
            }
          };
        } catch (e) {
          // ignore
        }

        win.focus();
      }

      document.getElementById('open-qandy').addEventListener('click', openQandy);
    })();
  </script>
</body>
</html>